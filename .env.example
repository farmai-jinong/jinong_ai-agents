# .env 로 복사해 채운다. .env 는 gitignore. 각 값의 SSOT 를 주석으로 남긴다(값 복사 대신 참조).

# --- auth (fail-closed) -------------------------------------------------------
# 외부 호출자(kafka-gateway 등)용 Bearer 키. 비어 있으면 기동 거부. 콤마로 여러 키(클라이언트별 발급/회수).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
# 로컬 개발 전용. 배포에서 절대 켜지 말 것.
#ALLOW_NO_AUTH=1

# 콜백 result_url 조립용 공개 주소
PUBLIC_BASE_URL=https://jinong-stt-report-generation.jinongservice.co.kr
LOG_LEVEL=info
# 컨테이너 내부 uvicorn 바인드(호스트 노출은 AGENT_BIND 로)
#HOST=0.0.0.0
#PORT=8080

# --- storage ------------------------------------------------------------------
# SQLite (compose 볼륨 /data). 로컬은 ./data/agent.db
DB_PATH=/data/agent.db
# S3 버킷 SSOT: audio_labeler-web/config.prd.yaml storage.s3 (bucket/region). 우리 산출물은 S3_PREFIX 아래에만.
S3_BUCKET=jinong-agri-stt
S3_PREFIX=agents/voicecall
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#S3_ENDPOINT_URL=
#MAX_AUDIO_MB=200
# /audio 수신 시 HEAD 로 존재/크기 검증 (끄면 STT 시점에야 오류 발견)
#S3_HEAD_ON_INGEST=true
# 로컬 개발 전용: local 이면 boto3 미사용, 파일시스템 스토리지 (배포는 항상 s3).
# 입력 오디오는 bucket != S3_BUCKET (예: "local") 이면 LOCAL_AUDIO_DIR/<key> 상대경로에서 읽고,
# 산출물은 LOCAL_STORAGE_DIR 아래 S3_PREFIX 레이아웃 그대로 기록. scripts/e2e_local.sh 참조.
#STORAGE_IMPL=s3
#LOCAL_STORAGE_DIR=./data/storage
#LOCAL_AUDIO_DIR=./data/audio-in

# --- STT (⑥ 게이트웨이; 계약 jinong_ai-gateway/docs/api-reference.md) ---------------
STT_BASE_URL=https://jinong-stt.jinongservice.co.kr
# 게이트웨이 .env GATEWAY_API_KEY 에 콤마로 추가 발급받은 이 서비스 전용 키
STT_API_KEY=
#STT_TIMEOUT=900
#STT_CONNECT_TIMEOUT=10
#STT_MAX_CONCURRENCY=2
#STT_MAX_ATTEMPTS=4

# --- LLM (provider 전환 = 아래 몇 개만) -------------------------------------------------
# gemini : Vertex AI(ChatGoogleGenerativeAI(vertexai=True)). LLM_MODEL=gemini-3.5-flash, GCP_PROJECT_ID/GCP_LOCATION, 인증은 서비스 계정 키
#          GOOGLE_APPLICATION_CREDENTIALS (compose 가 /app/auth/jinong_vertexai_service_key.json 로 마운트; 로컬은
#          /Users/jang-yeongbin/dev/auth/jinong_vertexai_service_key.json). LLM_BASE_URL/LLM_API_KEY 는 미사용.
# openai : LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=sk-..., LLM_MODEL=gpt-4.1
# jinong : LLM_BASE_URL=https://jinong-stt.jinongservice.co.kr/v1, LLM_API_KEY=<게이트웨이 키>, LLM_MODEL=exaone45
#          (게이트웨이 /v1/chat/completions 는 GPU vLLM :8000 을 프록시. gemini/openai 는 외부 처리 — 동의서 §7 충족을 위한 최종 목표는 jinong)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GCP_PROJECT_ID=jinong-lab-llm
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/app/auth/jinong_vertexai_service_key.json
GEMINI_THINKING_LEVEL=low          # minimal|low|medium|high (비우면 모델 기본=동적). low 가 기본 대비 지연 1/2·출력토큰 1/3, 픽스처 결과 동일
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=
#LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
#LLM_STRUCTURED_MODE=auto
#LLM_TEMPERATURE=0
#LLM_SEED=42
#LLM_TIMEOUT=120
#LLM_MAX_RETRIES=2

# --- generation ---------------------------------------------------------------
# 날짜별(멀티콜) daily 잡도 같은 gen 세마포어·재시도 정책을 공유한다 (call 생성이 우선 클레임).
PIPELINE_IMPL=langgraph            # fake = LLM 없이 배선 확인
#GEN_MAX_CONCURRENCY=2
#GEN_MAX_ATTEMPTS=2
#GEN_TIMEOUT_SEC=600
#NODE_TIMEOUT_S=180
#EXTRACT_MAX_INPUT_TOKENS=14000
#CHUNK_TOKENS=8000
#CHUNK_OVERLAP_TURNS=6
# 비어있지 않으면 프롬프트/응답 덤프 (디버그 전용)
#PROMPT_DUMP_DIR=

# --- farmos (kafka-gateway) — 읽기 전용, 농가 JWT 는 통화 시작 payload 로 받음 -----------
FARMOS_BASE_URL=https://dev.jinongservice.co.kr
#FARMOS_TIMEOUT=10

# --- callback (선택) ----------------------------------------------------------
#CALLBACK_ENABLED=true
#CALLBACK_API_KEY=
#CALLBACK_TIMEOUT=10

# --- worker -------------------------------------------------------------------
#WORKER_POLL_SEC=5
#END_STT_DEADLINE_SEC=3600
#AUDIO_AUTOCREATE_CALL=true
#TOKEN_PURGE_ON_TERMINAL=true
#RESULT_INLINE_MAX_KB=512
# 종료 시 진행 중 잡 대기 시간(초)
#SHUTDOWN_GRACE_SEC=20
# 일지 날짜 결정 등 서비스 타임존
#TZ=Asia/Seoul

# --- compose 전용 -------------------------------------------------------------
# 호스트 바인드. 기본 loopback 7003 (nginx 가 443 종단). 로컬 테스트도 동일.
#AGENT_BIND=127.0.0.1:7003
