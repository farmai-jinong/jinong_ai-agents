  ],
  "segments": [
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_0",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 3.743,
    "end": 6.173,
    "abs_start": 3.743,
    "abs_end": 6.173,
    "text": "선생님 동이다 채반에 통화 되세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_1",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 7.608,
    "end": 11.067,
    "abs_start": 7.608,
    "abs_end": 11.067,
    "text": "네, 사장님 오늘 미생물 넣는 날이라고 하셨죠?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_2",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 11.573,
    "end": 12.029,
    "abs_start": 11.573,
    "abs_end": 12.029,
    "text": "예."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_3",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 12.181,
    "end": 16.552,
    "abs_start": 12.181,
    "abs_end": 16.552,
    "text": "오존에 다 넣었어요. 그들 하던 대로 광합성균하고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_4",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 16.838,
    "end": 17.851,
    "abs_start": 16.838,
    "abs_end": 17.851,
    "text": "나머지 세 가지."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_5",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 18.678,
    "end": 20.011,
    "abs_start": 18.678,
    "abs_end": 20.011,
    "text": "해서 네 가지."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_6",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 20.281,
    "end": 21.074,
    "abs_start": 20.281,
    "abs_end": 21.074,
    "text": "6리터씩."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_7",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 21.867,
    "end": 23.437,
    "abs_start": 21.867,
    "abs_end": 23.437,
    "text": "우리 천 리터에 태워서."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_8",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 23.69,
    "end": 25.124,
    "abs_start": 23.69,
    "abs_end": 25.124,
    "text": "세동다 관주했어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_9",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 26.778,
    "end": 33.308,
    "abs_start": 26.778,
    "abs_end": 33.308,
    "text": "미생물 네 종 각 육 리터 물 천 리터 기존 세계 동관주요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_10",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 34.321,
    "end": 35.671,
    "abs_start": 34.321,
    "abs_end": 35.671,
    "text": "다른 것도 섞으셨어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_11",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 36.785,
    "end": 42.269,
    "abs_start": 36.785,
    "abs_end": 42.269,
    "text": "지금 과일 크는 때니까 비대용 비료를 1킬로 넣고 칼슘제도 넣었어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_12",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 43.012,
    "end": 44.935,
    "abs_start": 43.012,
    "abs_end": 44.935,
    "text": "그 플러스 칼이라고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_13",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 45.728,
    "end": 46.91,
    "abs_start": 45.728,
    "abs_end": 46.91,
    "text": "이십삼인가."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_14",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 47.095,
    "end": 47.872,
    "abs_start": 47.095,
    "abs_end": 47.872,
    "text": "뒤에 붙은 거."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_15",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 49.087,
    "end": 51.567,
    "abs_start": 49.087,
    "abs_end": 51.567,
    "text": "아 플러스 칼 이십삼이요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_16",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 52.58,
    "end": 55.229,
    "abs_start": 52.58,
    "abs_end": 55.229,
    "text": "칼슘제 넣으시는 건 잘 하시는 거예요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_17",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 56.14,
    "end": 58.435,
    "abs_start": 56.14,
    "abs_end": 58.435,
    "text": "요즘 팁 번 나오는 집 많거든요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_18",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 59.684,
    "end": 60.933,
    "abs_start": 59.684,
    "abs_end": 60.933,
    "text": "그런데 방제는요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_19",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 61.22,
    "end": 62.975,
    "abs_start": 61.22,
    "abs_end": 62.975,
    "text": "지난번에 응애 얘기하셨잖아요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_20",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 62.975,
    "end": 63.413,
    "abs_start": 62.975,
    "abs_end": 63.413,
    "text": "네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_21",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 64.662,
    "end": 67.835,
    "abs_start": 64.662,
    "abs_end": 67.835,
    "text": "그래서 오늘 새벽에 연막 불렸어요 일등이 전에요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_22",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 69.016,
    "end": 70.484,
    "abs_start": 69.016,
    "abs_end": 70.484,
    "text": "뭐뭐 놓고 돌리셨어요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_23",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 71.227,
    "end": 77.403,
    "abs_start": 71.227,
    "abs_end": 77.403,
    "text": "응애 약으로 다이마이트 넣고 곰팡이 약으로 그 크린 크린탭이요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_24",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 78.213,
    "end": 81.436,
    "abs_start": 78.213,
    "abs_end": 81.436,
    "text": "물을 갈아놓고 확산제 2,000밀리 넣어서."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_25",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 82.128,
    "end": 85.132,
    "abs_start": 82.128,
    "abs_end": 85.132,
    "text": "그것도 물 천리터예요. 세동 다 돌렸어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_26",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 87.089,
    "end": 95.712,
    "abs_start": 87.089,
    "abs_end": 95.712,
    "text": "다이마이트의 크림캡 확산제 2,000밀리리터 네 그 조합이면 응애하고 꽃곰팡이 둘 다 커버되죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_27",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 96.708,
    "end": 98.868,
    "abs_start": 96.708,
    "abs_end": 98.868,
    "text": "지금 발생 상황이 어느 정도인데요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_28",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 100.876,
    "end": 105.618,
    "abs_start": 100.876,
    "abs_end": 105.618,
    "text": "꽃곰팡이는 꽃의 거뭇한 게 조금 보이기 시작한 정도예요. 며칠 전부터."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_29",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 106.698,
    "end": 107.896,
    "abs_start": 106.698,
    "abs_end": 107.896,
    "text": "아 죽이네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_30",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 108.554,
    "end": 111.237,
    "abs_start": 108.554,
    "abs_end": 111.237,
    "text": "초기에 연막 돌리신 건 잘 잘 하셨어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_31",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 112.047,
    "end": 112.705,
    "abs_start": 112.047,
    "abs_end": 112.705,
    "text": "등에는요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_32",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 113.397,
    "end": 115.388,
    "abs_start": 113.397,
    "abs_end": 115.388,
    "text": "응애는 그보다 좀 있어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_33",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 115.642,
    "end": 118.223,
    "abs_start": 115.642,
    "abs_end": 118.223,
    "text": "뒤 들쳐보면 군데군데 있어요 안쪽."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_34",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 119.253,
    "end": 120.805,
    "abs_start": 119.253,
    "abs_end": 120.805,
    "text": "동이 특히 그래요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_35",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 122.307,
    "end": 125.75,
    "abs_start": 122.307,
    "abs_end": 125.75,
    "text": "군대 군대 수준이면 이번에 눌러놔야 해요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_36",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 126.593,
    "end": 128.939,
    "abs_start": 126.593,
    "abs_end": 128.939,
    "text": "다이마이트가 아래는 약하니까."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_37",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 129.53,
    "end": 131.032,
    "abs_start": 129.53,
    "abs_end": 131.032,
    "text": "산화을 뒤에 잎."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_38",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 131.167,
    "end": 132.533,
    "abs_start": 131.167,
    "abs_end": 132.533,
    "text": "뒤 다시 보시고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_39",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 132.989,
    "end": 136.398,
    "abs_start": 132.989,
    "abs_end": 136.398,
    "text": "살아 있으면 개통 다른 걸로 한 번 더 가야 합니다."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_40",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 137.09,
    "end": 138.676,
    "abs_start": 137.09,
    "abs_end": 138.676,
    "text": "그때 전화 주세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_41",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 140.026,
    "end": 141.376,
    "abs_start": 140.026,
    "abs_end": 141.376,
    "text": "아 예, 그럴게요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_42",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 141.832,
    "end": 142.203,
    "abs_start": 141.832,
    "abs_end": 142.203,
    "text": "아, 我."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_43",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 142.473,
    "end": 142.962,
    "abs_start": 142.473,
    "abs_end": 142.962,
    "text": "그."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_44",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 143.047,
    "end": 144.717,
    "abs_start": 143.047,
    "abs_end": 144.717,
    "text": "오늘 낮에 유치원."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_45",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 144.97,
    "end": 147.097,
    "abs_start": 144.97,
    "abs_end": 147.097,
    "text": "애들이 체험 왔다 갔어요. 서른 명이나."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_46",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 148.413,
    "end": 152.53,
    "abs_start": 148.413,
    "abs_end": 152.53,
    "text": "하하, 봄이라 체험 처리네요. 애들이 좋아했긴 했겠어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_47",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 153.61,
    "end": 157.441,
    "abs_start": 153.61,
    "abs_end": 157.441,
    "text": "좋아하다뿐이에요. 밭을 아주 뒤집어 놨지. 다음 주엔."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_48",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 157.998,
    "end": 161.778,
    "abs_start": 157.998,
    "abs_end": 161.778,
    "text": "면에서 딸기 축제 한다고 부스도 나가야 하고 바빠 죽겠어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_49",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 163.027,
    "end": 168.14,
    "abs_start": 163.027,
    "abs_end": 168.14,
    "text": "축제 준비까지 바쁘시네요. 그래도 미생물 관주는 다음 주에 거르지 마시고요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_50",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 168.663,
    "end": 170.941,
    "abs_start": 168.663,
    "abs_end": 170.941,
    "text": "두 일의 루틴 지키는 거."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_51",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 171.397,
    "end": 172.763,
    "abs_start": 171.397,
    "abs_end": 172.763,
    "text": "뿌리에 제일 좋습니다."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_52",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 173.59,
    "end": 174.046,
    "abs_start": 173.59,
    "abs_end": 174.046,
    "text": "예."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_53",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 174.046,
    "end": 176.003,
    "abs_start": 174.046,
    "abs_end": 176.003,
    "text": "그거는 뭐 무슨 일 있어도 해요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_54",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 177.168,
    "end": 180.965,
    "abs_start": 177.168,
    "abs_end": 180.965,
    "text": "네, 그럼 응애만 사날 뒤에 확인하고 통화하시죠."
