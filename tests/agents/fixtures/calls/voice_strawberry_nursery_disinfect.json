  "segments": [
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_0",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 3.693,
    "end": 4.891,
    "abs_start": 3.693,
    "abs_end": 4.891,
    "text": "네, 사장님."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_1",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 5.498,
    "end": 7.895,
    "abs_start": 5.498,
    "abs_end": 7.895,
    "text": "소득 오늘 하신다더니 다 하셨어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_2",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 8.857,
    "end": 11.371,
    "abs_start": 8.857,
    "abs_end": 11.371,
    "text": "아 예 다 했어요 아침부터 종일 했네."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_3",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 11.489,
    "end": 13.261,
    "abs_start": 11.489,
    "abs_end": 13.261,
    "text": "허리가 아주 끊어지는 줄 알았어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_4",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 14.965,
    "end": 15.877,
    "abs_start": 14.965,
    "abs_end": 15.877,
    "text": "고생했어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_5",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 16.366,
    "end": 18.762,
    "abs_start": 16.366,
    "abs_end": 18.762,
    "text": "어떻게 하셨는지 불러주시면 제가 정리해둘게요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_6",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 20.973,
    "end": 23.167,
    "abs_start": 20.973,
    "abs_end": 23.167,
    "text": "본 보는 스물다섯 말 했어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_7",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 23.639,
    "end": 24.061,
    "abs_start": 23.639,
    "abs_end": 24.061,
    "text": "그래서."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_8",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 24.483,
    "end": 25.85,
    "abs_start": 24.483,
    "abs_end": 25.85,
    "text": "꼭 또 흘러내리게 문법."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_9",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 27.487,
    "end": 29.815,
    "abs_start": 27.487,
    "abs_end": 29.815,
    "text": "이십오 마리면은 오백 리터네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_10",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 30.136,
    "end": 31.334,
    "abs_start": 30.136,
    "abs_end": 31.334,
    "text": "머무어 놓으셨어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_11",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 32.768,
    "end": 34.743,
    "abs_start": 32.768,
    "abs_end": 34.743,
    "text": "마코피카 한 병 넣고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_12",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 36.008,
    "end": 37.831,
    "abs_start": 36.008,
    "abs_end": 37.831,
    "text": "나오와이 50ml 넣었지."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_13",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 39.873,
    "end": 42.792,
    "abs_start": 39.873,
    "abs_end": 42.792,
    "text": "마코피크 한 병에 나노아이 오십 밀리리터."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_14",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 42.978,
    "end": 45.661,
    "abs_start": 42.978,
    "abs_end": 45.661,
    "text": "본포는 영양 위주로 가셨네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_15",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 46.302,
    "end": 47.332,
    "abs_start": 46.302,
    "abs_end": 47.332,
    "text": "육묘장은요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_16",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 47.922,
    "end": 48.968,
    "abs_start": 47.922,
    "abs_end": 48.968,
    "text": "종묘장은 약을."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_17",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 48.968,
    "end": 49.373,
    "abs_start": 48.968,
    "abs_end": 49.373,
    "text": "소소."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_18",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 50.032,
    "end": 50.69,
    "abs_start": 50.032,
    "abs_end": 50.69,
    "text": "이라고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_19",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 50.858,
    "end": 52.478,
    "abs_start": 50.858,
    "abs_end": 52.478,
    "text": "나방약 모스칼하고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_20",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 53.255,
    "end": 54.436,
    "abs_start": 53.255,
    "abs_end": 54.436,
    "text": "그것도 스물다섯 말."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_21",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 54.908,
    "end": 57.659,
    "abs_start": 54.908,
    "abs_end": 57.659,
    "text": "미스트로 구석구석 전체 소독했어. 거기도."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_22",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 58.283,
    "end": 60.173,
    "abs_start": 58.283,
    "abs_end": 60.173,
    "text": "마코피카 한 병에."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_23",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 61.034,
    "end": 62.232,
    "abs_start": 61.034,
    "abs_end": 62.232,
    "text": "오호이 오십미리."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_24",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 64.223,
    "end": 67.413,
    "abs_start": 64.223,
    "abs_end": 67.413,
    "text": "닥코넬이면 닥코넬 에이스 말씀이시죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_25",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 67.514,
    "end": 68.797,
    "abs_start": 67.514,
    "abs_end": 68.797,
    "text": "액상으로 탄 거."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_26",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 69.455,
    "end": 69.978,
    "abs_start": 69.455,
    "abs_end": 69.978,
    "text": "어 그."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_27",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 69.978,
    "end": 70.231,
    "abs_start": 69.978,
    "abs_end": 70.231,
    "text": "뭐."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_28",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 70.433,
    "end": 71.8,
    "abs_start": 70.433,
    "abs_end": 71.8,
    "text": "통에 그렇게 써있더라고만."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_29",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 73.133,
    "end": 76.154,
    "abs_start": 73.133,
    "abs_end": 76.154,
    "text": "네 탄저 잡는 걸로는 잘 고르셨어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_30",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 76.897,
    "end": 79.023,
    "abs_start": 76.897,
    "abs_end": 79.023,
    "text": "육묘장의 탄저 힘이 있었어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_31",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 80.542,
    "end": 82.955,
    "abs_start": 80.542,
    "abs_end": 82.955,
    "text": "어미묘 앞에 까만 점 있는 게 몇?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_32",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 83.14,
    "end": 84.305,
    "abs_start": 83.14,
    "abs_end": 84.305,
    "text": "보이 보이더라고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_33",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 84.777,
    "end": 87.73,
    "abs_start": 84.777,
    "abs_end": 87.73,
    "text": "한조인지 아닌지는 몰라도 미심쩍어서."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_34",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 88.658,
    "end": 89.924,
    "abs_start": 88.658,
    "abs_end": 89.924,
    "text": "응 미리 친 거지."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_35",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 92.017,
    "end": 95.324,
    "abs_start": 92.017,
    "abs_end": 95.324,
    "text": "몇 폭이 수준이고 의심 당기면 잘 하신 거예요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_36",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 95.999,
    "end": 98.463,
    "abs_start": 95.999,
    "abs_end": 98.463,
    "text": "그 포기들은 이 삼 일 더 보시고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_37",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 99.205,
    "end": 101.956,
    "abs_start": 99.205,
    "abs_end": 101.956,
    "text": "점이 퍼지면 사진 찍어서 보내주세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_38",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 102.209,
    "end": 102.884,
    "abs_start": 102.209,
    "abs_end": 102.884,
    "text": "나방은요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_39",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 103.846,
    "end": 106.428,
    "abs_start": 103.846,
    "abs_end": 106.428,
    "text": "나방은 이번에 벌레가 많이 다녔어."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_40",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 106.478,
    "end": 107.272,
    "abs_start": 106.478,
    "abs_end": 107.272,
    "text": "어린."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_41",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 108.149,
    "end": 110.343,
    "abs_start": 108.149,
    "abs_end": 110.343,
    "text": "어린잎마다 구멍이 송송 나고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_42",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 110.562,
    "end": 112.132,
    "abs_start": 110.562,
    "abs_end": 112.132,
    "text": "피커먼 애벌레가 뛰어다니고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_43",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 113.026,
    "end": 113.87,
    "abs_start": 113.026,
    "abs_end": 113.87,
    "text": "하반인 것 같아."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_44",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 115.439,
    "end": 119.371,
    "abs_start": 115.439,
    "abs_end": 119.371,
    "text": "아, 네, 이맘때 육묘장 파방 나방이 극성이죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_45",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 120.097,
    "end": 123.286,
    "abs_start": 120.097,
    "abs_end": 123.286,
    "text": "지난주에 엑셀트 지셨다고 했잖아요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_46",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 123.539,
    "end": 124.298,
    "abs_start": 123.539,
    "abs_end": 124.298,
    "text": "그건 어때요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_47",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 125.918,
    "end": 129.952,
    "abs_start": 125.918,
    "abs_end": 129.952,
    "text": "세츠는 그냥 그랬어. 근데 이번 모스킬은."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_48",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 130.222,
    "end": 131.032,
    "abs_start": 130.222,
    "abs_end": 131.032,
    "text": "아주 식빵이야."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_49",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 131.69,
    "end": 133.85,
    "abs_start": 131.69,
    "abs_end": 133.85,
    "text": "저녁에 가 보니까 벌레가 싹 떨어졌어."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_50",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 134.373,
    "end": 135.402,
    "abs_start": 134.373,
    "abs_end": 135.402,
    "text": "효과 매우 좋아 이거는."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_51",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 134.693,
    "end": 134.913,
    "abs_start": 134.693,
    "abs_end": 134.913,
    "text": "외우."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_52",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 136.482,
    "end": 141.038,
    "abs_start": 136.482,
    "abs_end": 141.038,
    "text": "오 그럼 파반나 파반나방의 모스 킬이 잘 듣는 걸로 적어둘게요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_53",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 141.764,
    "end": 144.548,
    "abs_start": 141.764,
    "abs_end": 144.548,
    "text": "계통을 번갈아 쓰신 것도 잘 하신 거고요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_54",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 145.679,
    "end": 146.033,
    "abs_start": 145.679,
    "abs_end": 146.033,
    "text": "그런가."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_55",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 146.658,
    "end": 150.944,
    "abs_start": 146.658,
    "abs_end": 150.944,
    "text": "아 그리고 이번 주에 날아 뺀다고 사람을 먹고 해서 아주 애먹었어."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_56",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 152.48,
    "end": 154.555,
    "abs_start": 152.48,
    "abs_end": 154.555,
