  "segments": [
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_0",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 3.018,
    "end": 8.182,
    "abs_start": 3.018,
    "abs_end": 8.182,
    "text": "여보세요 사장님 안녕하세요 농업기술센터 상담사입니다 통화 괜찮으세요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_1",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 9.008,
    "end": 10.105,
    "abs_start": 9.008,
    "abs_end": 10.105,
    "text": "하이 군네 안녕하세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_2",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 10.358,
    "end": 12.333,
    "abs_start": 10.358,
    "abs_end": 12.333,
    "text": "마침 하우스에서 잠깐 언참이에요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_3",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 13.126,
    "end": 17.277,
    "abs_start": 13.126,
    "abs_end": 17.277,
    "text": "지난 주에 태풍 올라온다고 해서 걱정했는데 그쪽은 피해 없으셨어요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_4",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 18.256,
    "end": 19.707,
    "abs_start": 18.256,
    "abs_end": 19.707,
    "text": "어 다행히 비켜갔어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_5",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 19.943,
    "end": 21.209,
    "abs_start": 19.943,
    "abs_end": 21.209,
    "text": "발람만 좀 보고 말지."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_6",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 21.513,
    "end": 24.584,
    "abs_start": 21.513,
    "abs_end": 24.584,
    "text": "옆 동네는 비닐 찌전진데도 있다던데 우유는 멀쩡해요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_7",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 25.445,
    "end": 26.255,
    "abs_start": 25.445,
    "abs_end": 26.255,
    "text": "다행이네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_8",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 26.693,
    "end": 28.955,
    "abs_start": 26.693,
    "abs_end": 28.955,
    "text": "그런 본론으로 정식 다 끝나셨죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_9",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 29.866,
    "end": 32.347,
    "abs_start": 29.866,
    "abs_end": 32.347,
    "text": "예 끝났어요 십일일에 시작해서."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_10",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 33.477,
    "end": 34.422,
    "abs_start": 33.477,
    "abs_end": 34.422,
    "text": "어 몇 책을 읽다가."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_11",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 34.962,
    "end": 35.84,
    "abs_start": 34.962,
    "abs_end": 35.84,
    "text": "한 열을 했나?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_12",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 36.599,
    "end": 38.152,
    "abs_start": 36.599,
    "abs_end": 38.152,
    "text": "아이다 19일에 마쳤으니까."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_13",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 38.438,
    "end": 39.232,
    "abs_start": 38.438,
    "abs_end": 39.232,
    "text": "아홉에 걸렸네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_14",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 40.7,
    "end": 43.012,
    "abs_start": 40.7,
    "abs_end": 43.012,
    "text": "9월 11일부터 19일까지요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_15",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 43.552,
    "end": 45.155,
    "abs_start": 43.552,
    "abs_end": 45.155,
    "text": "올해는 몇 주나 들어갔어요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_16",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 46.775,
    "end": 47.534,
    "abs_start": 46.775,
    "abs_end": 47.534,
    "text": "어."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_17",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 47.905,
    "end": 49.289,
    "abs_start": 47.905,
    "abs_end": 49.289,
    "text": "동장, 동당."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_18",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 49.559,
    "end": 50.15,
    "abs_start": 49.559,
    "abs_end": 50.15,
    "text": "만주식."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_19",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 50.386,
    "end": 51.314,
    "abs_start": 50.386,
    "abs_end": 51.314,
    "text": "여섯 떙이니까."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_20",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 51.584,
    "end": 52.529,
    "abs_start": 51.584,
    "abs_end": 52.529,
    "text": "육만 주 들어왔지요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_21",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 53.66,
    "end": 56.005,
    "abs_start": 53.66,
    "abs_end": 56.005,
    "text": "6만 주면 작년보다 좀 늘리셨네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_22",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 57.018,
    "end": 58.115,
    "abs_start": 57.018,
    "abs_end": 58.115,
    "text": "한 동 더 지었잖아요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_23",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 58.975,
    "end": 61.304,
    "abs_start": 58.975,
    "abs_end": 61.304,
    "text": "그나즈나 모전 값이 올라서 아주 혼났어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_24",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 61.878,
    "end": 62.654,
    "abs_start": 61.878,
    "abs_end": 62.654,
    "text": "작년보다."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_25",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 62.924,
    "end": 64.443,
    "abs_start": 62.924,
    "abs_end": 64.443,
    "text": "주당 백 원씩은 더 쳤다니까."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_26",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 65.438,
    "end": 70.113,
    "abs_start": 65.438,
    "abs_end": 70.113,
    "text": "요즘 다들 그 얘기하세요. 육묘장들이 값을 많이 올렸다고 하더라고요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_27",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 71.007,
    "end": 74.872,
    "abs_start": 71.007,
    "abs_end": 74.872,
    "text": "그게 말이에요. 내년에는 우리가 좀 키워볼까 싶기도 하고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_28",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 75.968,
    "end": 78.297,
    "abs_start": 75.968,
    "abs_end": 78.297,
    "text": "그건 겨울에 한번 같이 계획 잡아보시죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_29",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 79.276,
    "end": 81.082,
    "abs_start": 79.276,
    "abs_end": 81.082,
    "text": "물 관리는 지금 어떻게 하고 계세요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_30",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 82.533,
    "end": 83.461,
    "abs_start": 82.533,
    "abs_end": 83.461,
    "text": "물은."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_31",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 83.798,
    "end": 85.587,
    "abs_start": 83.798,
    "abs_end": 85.587,
    "text": "아침 여덟 시에 차물을 주고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_32",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 85.975,
    "end": 87.308,
    "abs_start": 85.975,
    "abs_end": 87.308,
    "text": "두 시에 마지막 모이죠요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_33",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 88.405,
    "end": 89.654,
    "abs_start": 88.405,
    "abs_end": 89.654,
    "text": "하루에 몇 번 나눠서요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_34",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 90.498,
    "end": 91.038,
    "abs_start": 90.498,
    "abs_end": 91.038,
    "text": "세 번."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_35",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 91.358,
    "end": 92.101,
    "abs_start": 91.358,
    "abs_end": 92.101,
    "text": "아 아니다."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_36",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 92.438,
    "end": 94.193,
    "abs_start": 92.438,
    "abs_end": 94.193,
    "text": "지난 주부터 한 번씩 늘려서."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_37",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 94.565,
    "end": 95.105,
    "abs_start": 94.565,
    "abs_end": 95.105,
    "text": "네 번 줘요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_38",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 95.324,
    "end": 96.522,
    "abs_start": 95.324,
    "abs_end": 96.522,
    "text": "한 번에 삼 분씩."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_39",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 97.636,
    "end": 102.8,
    "abs_start": 97.636,
    "abs_end": 102.8,
    "text": "오전 여덟 시부터 오후 두 시 사이에 사 회 그리고 회당 삼 분이네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_40",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 103.39,
    "end": 105.179,
    "abs_start": 103.39,
    "abs_end": 105.179,
    "text": "활착기니까 적당하네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_41",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 105.787,
    "end": 106.951,
    "abs_start": 105.787,
    "abs_end": 106.951,
    "text": "그백 농도는요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_42",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 108.436,
    "end": 109.752,
    "abs_start": 108.436,
    "abs_end": 109.752,
    "text": "이 시는 낯게."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_43",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 110.191,
    "end": 111.794,
    "abs_start": 110.191,
    "abs_end": 111.794,
    "text": "0.7로 맞췄어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_44",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 112.807,
    "end": 114.511,
    "abs_start": 112.807,
    "abs_end": 114.511,
    "text": "혹시 산도는 확인해 보셨어요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_45",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 115.608,
    "end": 116.688,
    "abs_start": 115.608,
    "abs_end": 116.688,
    "text": "pH는."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_46",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 117.16,
    "end": 118.038,
    "abs_start": 117.16,
    "abs_end": 118.038,
    "text": "유부로 나오더라고요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_47",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 118.645,
    "end": 119.371,
    "abs_start": 118.645,
    "abs_end": 119.371,
    "text": "점 영."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_48",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 120.788,
    "end": 125.986,
    "abs_start": 120.788,
    "abs_end": 125.986,
    "text": "이 신은 0.7에 pH 6.0이면 활짝 킵 표준 그대로예요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_49",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 126.492,
    "end": 127.673,
    "abs_start": 126.492,
    "abs_end": 127.673,
    "text": "잘하고 계시네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_50",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 128.635,
    "end": 129.884,
    "abs_start": 128.635,
    "abs_end": 129.884,
    "text": "애들 상태는 어때요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_51",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 130.728,
    "end": 131.926,
    "abs_start": 130.728,
    "abs_end": 131.926,
    "text": "팔착은 잘 됐어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_52",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 133.04,
    "end": 135.487,
    "abs_start": 133.04,
    "abs_end": 135.487,
    "text": "대체로 잘 잡았는데 몇 가지가 걸려요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_53",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 135.925,
    "end": 136.6,
    "abs_start": 135.925,
    "abs_end": 136.6,
    "text": "그."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_54",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 137.242,
    "end": 138.457,
    "abs_start": 137.242,
    "abs_end": 138.457,
    "text": "시드는 포기가 있어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_55",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 139.537,
    "end": 140.566,
    "abs_start": 139.537,
    "abs_end": 140.566,
    "text": "시들음 증상이요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_56",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 140.971,
    "end": 141.899,
    "abs_start": 140.971,
    "abs_end": 141.899,
    "text": "어느 정도나 돼요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_57",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 142.793,
    "end": 143.688,
    "abs_start": 142.793,
    "abs_end": 143.688,
    "text": "군데군데 있어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_58",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 144.025,
    "end": 145.713,
    "abs_start": 144.025,
    "abs_end": 145.713,
    "text": "어제 돌면서 세어 보니까."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_59",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 146.371,
    "end": 147.502,
    "abs_start": 146.371,
    "abs_end": 147.502,
    "text": "열 포기는 넘던데."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_60",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 147.991,
    "end": 149.138,
    "abs_start": 147.991,
    "abs_end": 149.138,
    "text": "한동의 산업 포개시."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_61",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 150.387,
    "end": 155.264,
    "abs_start": 150.387,
    "abs_end": 155.264,
    "text": "6만 주에 그 정도면 아직 초기지만 시들음병은 놔두면 옆으로 가니까요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_62",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 155.838,
    "end": 159.82,
    "abs_start": 155.838,
    "abs_end": 159.82,
    "text": "잎이 잎이 낮에 쳐졌다가 저녁에 도로 서요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_63",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 160.208,
    "end": 162.74,
    "abs_start": 160.208,
    "abs_end": 162.74,
    "text": "맞아요, 딱 그래요. 아침에 멀쩡하고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_64",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 163.533,
    "end": 165.338,
    "abs_start": 163.533,
    "abs_end": 165.338,
    "text": "시드름병 맞는 것 같네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_65",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 165.811,
    "end": 170.131,
    "abs_start": 165.811,
    "abs_end": 170.131,
    "text": "이병준은 아깝다 생각 마시고 뽑아서 밖으로 내가세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_66",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 170.519,
    "end": 171.278,
    "abs_start": 170.519,
    "abs_end": 171.278,
    "text": "뿌리 채로요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_67",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 172.409,
    "end": 173.675,
    "abs_start": 172.409,
    "abs_end": 173.675,
    "text": "아 역시 그래야겠죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_68",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 174.029,
    "end": 174.772,
    "abs_start": 174.029,
    "abs_end": 174.772,
    "text": "이번 추안에."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_69",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 175.193,
    "end": 176.965,
    "abs_start": 175.193,
    "abs_end": 176.965,
    "text": "한 이 삼이라니 법안 낼게요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_70",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 178.231,
    "end": 178.737,
    "abs_start": 178.231,
    "abs_end": 178.737,
    "text": "네."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_71",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 179.108,
    "end": 183.935,
    "abs_start": 179.108,
    "abs_end": 183.935,
    "text": "뽑은 자리는 관주 라인 물 튀지 않게만 조심하시고요. 다른 건요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_72",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 185.268,
    "end": 186.668,
    "abs_start": 185.268,
    "abs_end": 186.668,
    "text": "탄저도 살짝 보여요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_73",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 187.192,
    "end": 189.875,
    "abs_start": 187.192,
    "abs_end": 189.875,
    "text": "잎에 까만 반점 있는 게 몇 포기 있더라고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_74",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 191.258,
    "end": 194.228,
    "abs_start": 191.258,
    "abs_end": 194.228,
    "text": "그 폭이 수준이면 아직 약칠 단계는 아니에요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_75",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 194.718,
    "end": 196.777,
    "abs_start": 194.718,
    "abs_end": 196.777,
    "text": "대신 물 틔면 번지니까."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_76",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 197.418,
    "end": 202.092,
    "abs_start": 197.418,
    "abs_end": 202.092,
    "text": "두상관수는 절대 하지 마시고 며칠 더 지켜보다가 늘면 바로 전화 주세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_77",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 202.75,
    "end": 204.505,
    "abs_start": 202.75,
    "abs_end": 204.505,
    "text": "그때 약재 정제해 드릴게요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_78",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 205.096,
    "end": 207.695,
    "abs_start": 205.096,
    "abs_end": 207.695,
    "text": "알겠어요. 그거 이게 제일 골치인데."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_79",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 208.488,
    "end": 209.939,
    "abs_start": 208.488,
    "abs_end": 209.939,
    "text": "벌레가 잎을 가위가 먹어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_80",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 210.833,
    "end": 211.863,
    "abs_start": 210.833,
    "abs_end": 211.863,
    "text": "어떤 모양으로요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_81",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 212.639,
    "end": 214.867,
    "abs_start": 212.639,
    "abs_end": 214.867,
    "text": "세입을 여기저기 깔가 먹은 자국이 많아요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_82",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 215.474,
    "end": 216.925,
    "abs_start": 215.474,
    "abs_end": 216.925,
    "text": "잎이 그물처럼 되고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_83",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 217.887,
    "end": 218.36,
    "abs_start": 217.887,
    "abs_end": 218.36,
    "text": "어제."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_84",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 219.153,
    "end": 220.199,
    "abs_start": 219.153,
    "abs_end": 220.199,
    "text": "이 디지몬이가."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_85",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 220.435,
    "end": 221.296,
    "abs_start": 220.435,
    "abs_end": 221.296,
    "text": "시커먼 펄라이."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_86",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 221.617,
    "end": 223.54,
    "abs_start": 221.617,
    "abs_end": 223.54,
    "text": "시커먼 해벌레도 몇 마리 잡았어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_87",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 224.452,
    "end": 226.628,
    "abs_start": 224.452,
    "abs_end": 226.628,
    "text": "그거 파밤나방 유충이에요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_88",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 227.236,
    "end": 229.902,
    "abs_start": 227.236,
    "abs_end": 229.902,
    "text": "이맘 때 정식 직후에 꼭 들어옵니다."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_89",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 230.746,
    "end": 232.855,
    "abs_start": 230.746,
    "abs_end": 232.855,
    "text": "피해가 그 정도면 약을 치셔야 해요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_90",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 234.222,
    "end": 235.64,
    "abs_start": 234.222,
    "abs_end": 235.64,
    "text": "그래서 신은 벌써 쳤어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_91",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 235.91,
    "end": 237.479,
    "abs_start": 235.91,
    "abs_end": 237.479,
    "text": "창고에 캡틴이 있길래."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_92",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 237.968,
    "end": 240.112,
    "abs_start": 237.968,
    "abs_end": 240.112,
    "text": "오늘 아침에 캐틴 천배로."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_93",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 241.057,
    "end": 241.799,
    "abs_start": 241.057,
    "abs_end": 241.799,
    "text": "한 번 돌렸어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_94",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 243.149,
    "end": 244.094,
    "abs_start": 243.149,
    "abs_end": 244.094,
    "text": "캡틴 유재형."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_95",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 244.533,
    "end": 245.512,
    "abs_start": 244.533,
    "abs_end": 245.512,
    "text": "잘하셨어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_96",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 245.917,
    "end": 246.878,
    "abs_start": 245.917,
    "abs_end": 246.878,
    "text": "파밤나방은."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_97",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 247.182,
    "end": 248.903,
    "abs_start": 247.182,
    "abs_end": 248.903,
    "text": "에 등록된 약제예요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_98",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 250.0,
    "end": 254.084,
    "abs_start": 250.0,
    "abs_end": 254.084,
    "text": "천배면 배수도 맞고요. 어린 유충일 때 쳐야 됐거든요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_99",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 256.092,
    "end": 260.024,
    "abs_start": 256.092,
    "abs_end": 260.024,
    "text": "아침에 치고 나오는 길에 보니까 괴로 뛰어다니는 놈이 있긴 하던데."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_100",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 261.07,
    "end": 262.859,
    "abs_start": 261.07,
    "abs_end": 262.859,
    "text": "약 친 당일 날은 그래요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_101",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 262.977,
    "end": 268.175,
    "abs_start": 262.977,
    "abs_end": 268.175,
    "text": "이 삼일 보시고 그래도 살아있으면 개통 다른 약으로 바꿔야 하니까 다시 얘기하시죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_102",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 268.968,
    "end": 271.988,
    "abs_start": 268.968,
    "abs_end": 271.988,
    "text": "아 그리고 사장님 천적 신청하셨던 거 왔어요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_103",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 272.95,
    "end": 274.823,
    "abs_start": 272.95,
    "abs_end": 274.823,
    "text": "예, 그저께 택배를 왔어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_104",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 275.228,
    "end": 275.853,
    "abs_start": 275.228,
    "abs_end": 275.853,
    "text": "이리 응해."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_105",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 276.595,
    "end": 278.35,
    "abs_start": 276.595,
    "abs_end": 278.35,
    "text": "옹지제로 여섯 동이 다 넣었어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_106",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 279.228,
    "end": 280.156,
    "abs_start": 279.228,
    "abs_end": 280.156,
    "text": "잘하셨네요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_107",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 280.747,
    "end": 283.396,
    "abs_start": 280.747,
    "abs_end": 283.396,
    "text": "이리응에 넣으셨으면 앞으로는 응의 약이나."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_108",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 283.75,
    "end": 286.872,
    "abs_start": 283.75,
    "abs_end": 286.872,
    "text": "독한 살충제 치실 때 저한테 먼저 물어보세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_109",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 287.142,
    "end": 289.522,
    "abs_start": 287.142,
    "abs_end": 289.522,
    "text": "천적 다 죽으면 돈 버리는 거라."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_110",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 290.264,
    "end": 292.88,
    "abs_start": 290.264,
    "abs_end": 292.88,
    "text": "그래서 캐팅 칠 때도 좀 찌방이 했는데."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_111",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 294.027,
    "end": 297.031,
    "abs_start": 294.027,
    "abs_end": 297.031,
    "text": "캡틴은 천적한테 비교적 순한 편이라 괜찮습니다."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_112",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 297.183,
    "end": 298.465,
    "abs_start": 297.183,
    "abs_end": 298.465,
    "text": "그건 잘 고르셨어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_113",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 298.904,
    "end": 299.765,
    "abs_start": 298.904,
    "abs_end": 299.765,
    "text": "다행이에요."
   },
   {
    "file_index": 0,
