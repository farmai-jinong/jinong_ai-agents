   }
  ],
  "segments": [
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_0",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 2.461,
    "end": 3.642,
    "abs_start": 2.461,
    "abs_end": 3.642,
    "text": "여보세요, 김 사장님."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_1",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 3.963,
    "end": 5.279,
    "abs_start": 3.963,
    "abs_end": 5.279,
    "text": "본데 고생 많으시죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_2",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 5.819,
    "end": 7.439,
    "abs_start": 5.819,
    "abs_end": 7.439,
    "text": "바로 이 때문에 전해주셨다고요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_3",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 8.435,
    "end": 12.552,
    "abs_start": 8.435,
    "abs_end": 12.552,
    "text": "예 안녕하십니까 아유 하우스가 한장막이에요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_4",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 13.193,
    "end": 14.763,
    "abs_start": 13.193,
    "abs_end": 14.763,
    "text": "사진 사람이 못 들어가요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_5",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 15.488,
    "end": 19.015,
    "abs_start": 15.488,
    "abs_end": 19.015,
    "text": "아 요즘 다들 새벽 작업만 하시더라고요 수확은 계속 나오고 있어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_6",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 20.922,
    "end": 27.807,
    "abs_start": 20.922,
    "abs_end": 27.807,
    "text": "수확은 매일 하지. 오늘 새벽에도 닦고요. 요즘 하루에 한 키, 백 킬로씩 나와요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_7",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 28.28,
    "end": 30.929,
    "abs_start": 28.28,
    "abs_end": 30.929,
    "text": "색깔도 잘 나오고 물건 좋아요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_8",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 31.773,
    "end": 33.967,
    "abs_start": 31.773,
    "abs_end": 33.967,
    "text": "클로면 꾸준하네요. 품질 좋다니."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_9",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 33.967,
    "end": 34.675,
    "abs_start": 33.967,
    "abs_end": 34.675,
    "text": "다행이고요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_10",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 34.962,
    "end": 36.717,
    "abs_start": 34.962,
    "abs_end": 36.717,
    "text": "그래서 가로이는 어떤 상황이에요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_11",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 37.949,
    "end": 41.695,
    "abs_start": 37.949,
    "abs_end": 41.695,
    "text": "아, 제가 요즘 아침마다 한 바퀴 돌면서 살펴보거든요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_12",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 42.505,
    "end": 49.036,
    "abs_start": 42.505,
    "abs_end": 49.036,
    "text": "그 잎기부터 잎의 뒤에 하얀 게 많이 붙어가지고 있어요. 잎을 툭 치면 하얗게 막 날아 올라."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_13",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 49.036,
    "end": 49.34,
    "abs_start": 49.036,
    "abs_end": 49.34,
    "text": "나요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_14",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 50.639,
    "end": 54.115,
    "abs_start": 50.639,
    "abs_end": 54.115,
    "text": "폭치면 날아오르는 하얀 벌레면 담배 가루이 맞아요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_15",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 54.318,
    "end": 55.55,
    "abs_start": 54.318,
    "abs_end": 55.55,
    "text": "여름 수학기에."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_16",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 55.988,
    "end": 57.17,
    "abs_start": 55.988,
    "abs_end": 57.17,
    "text": "되게 고치 아픈 놈이죠."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_17",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 58.199,
    "end": 60.713,
    "abs_start": 58.199,
    "abs_end": 60.713,
    "text": "놔두면 그을음병까지 오니까 잡으셔야 돼요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_18",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 62.013,
    "end": 73.032,
    "abs_start": 62.013,
    "abs_end": 73.032,
    "text": "그럴 것 같아서 오늘 아침에 약 쳤어요. 농약사에서 가루의약 달라니까 검객이라고 주더라고요. 검객 수화제 첨대로 아침."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_19",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 73.032,
    "end": 74.095,
    "abs_start": 73.032,
    "abs_end": 74.095,
    "text": "일찍 쳤어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_20",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 74.568,
    "end": 79.057,
    "abs_start": 74.568,
    "abs_end": 79.057,
    "text": "엄캐기면 가루에 등록된 양 맞습니다. 잘 치셨어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_21",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 79.495,
    "end": 86.009,
    "abs_start": 79.495,
    "abs_end": 86.009,
    "text": "대신 가로 있는 아리랑 약충이 잎 뒤에 남아서 한 번으로 안 끝나요. 서리 뒤에 앞뒤 다시 보시고."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_22",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 86.718,
    "end": 90.262,
    "abs_start": 86.718,
    "abs_end": 90.262,
    "text": "여전히 날이 오르면 개통 다른 걸로 한 번 더 가야 합니다."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_23",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 91.021,
    "end": 94.193,
    "abs_start": 91.021,
    "abs_end": 94.193,
    "text": "네, 예 사흘 뒤에 보고 전화 드릴게요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_24",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 94.548,
    "end": 97.315,
    "abs_start": 94.548,
    "abs_end": 97.315,
    "text": "수학 중인데 약 치는 건 괜찮은 거죠?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_25",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 98.024,
    "end": 105.466,
    "abs_start": 98.024,
    "abs_end": 105.466,
    "text": "아, 그게 그게 중요한데요. 그 범갱 라벨에 수확 전 안전 사용 기준 있으니까 며칠 띄우고 따야 하는지 꼭."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_26",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 105.972,
    "end": 107.153,
    "abs_start": 105.972,
    "abs_end": 107.153,
    "text": "확인하시고 지키세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_27",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 107.913,
    "end": 110.073,
    "abs_start": 107.913,
    "abs_end": 110.073,
    "text": "그리고 노랑 끈끈이 트랩 있잖아요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_28",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 110.866,
    "end": 112.064,
    "abs_start": 110.866,
    "abs_end": 112.064,
    "text": "이거 통로마다 좀."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_29",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 112.317,
    "end": 113.313,
    "abs_start": 112.317,
    "abs_end": 113.313,
    "text": "더 달아 주세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_30",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 114.173,
    "end": 115.945,
    "abs_start": 114.173,
    "abs_end": 115.945,
    "text": "밑도 보는데도."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_31",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 116.468,
    "end": 118.004,
    "abs_start": 116.468,
    "abs_end": 118.004,
    "text": "잡는 데도 좋아요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_32",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 119.118,
    "end": 119.978,
    "abs_start": 119.118,
    "abs_end": 119.978,
    "text": "아 끈끈이."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_33",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 119.978,
    "end": 121.193,
    "abs_start": 119.978,
    "abs_end": 121.193,
    "text": "참고 있어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_34",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 121.514,
    "end": 123.151,
    "abs_start": 121.514,
    "abs_end": 123.151,
    "text": "네, 메달은 어떻게요?"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_35",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 123.505,
    "end": 129.023,
    "abs_start": 123.505,
    "abs_end": 129.023,
    "text": "아 그리고 옆집 행님네는 오이하는데 거기도 가루이가 왔대요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_36",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 129.479,
    "end": 130.036,
    "abs_start": 129.479,
    "abs_end": 130.036,
    "text": "온 동."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_37",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 130.036,
    "end": 130.93,
    "abs_start": 130.036,
    "abs_end": 130.93,
    "text": "난리네."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_38",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 132.23,
    "end": 133.073,
    "abs_start": 132.23,
    "abs_end": 133.073,
    "text": "하하하."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_39",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 133.478,
    "end": 135.605,
    "abs_start": 133.478,
    "abs_end": 135.605,
    "text": "더위에 가루이 안 나오는 데가 없어요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_40",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 136.027,
    "end": 137.107,
    "abs_start": 136.027,
    "abs_end": 137.107,
    "text": "옆집 분도."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_41",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 137.36,
    "end": 139.435,
    "abs_start": 137.36,
    "abs_end": 139.435,
    "text": "상담 필요하시면 전화 주시라고 하세요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_42",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 140.228,
    "end": 140.971,
    "abs_start": 140.228,
    "abs_end": 140.971,
    "text": "예 전화."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_43",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 140.971,
    "end": 141.68,
    "abs_start": 140.971,
    "abs_end": 141.68,
    "text": "들 키요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_44",
    "speaker": "B",
    "speaker_key": "f0:B",
    "start": 143.165,
    "end": 146.033,
    "abs_start": 143.165,
    "abs_end": 146.033,
    "text": "요 요즘 경매값은 좀 어때요? 우리 물건값이"
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_45",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 146.033,
    "end": 147.434,
    "abs_start": 146.033,
    "abs_end": 147.434,
    "text": "이 형 신청치 않던데."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_46",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 148.177,
    "end": 149.83,
    "abs_start": 148.177,
    "abs_end": 149.83,
    "text": "요즘 물량 몰릴 때라 그래요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_47",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 150.134,
    "end": 152.918,
    "abs_start": 150.134,
    "abs_end": 152.918,
    "text": "다음 주부터 휴가철 수요 부르면 좀 나아질 거예요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_48",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 154.505,
    "end": 156.648,
    "abs_start": 154.505,
    "abs_end": 156.648,
    "text": "그 말만 믿고 버텨볼게요. 하하하."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_49",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 157.643,
    "end": 160.765,
    "abs_start": 157.643,
    "abs_end": 160.765,
    "text": "네, 그럼 정리할게요. 검객 친 거 사흘 뒤 확인."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_50",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 161.288,
    "end": 162.132,
    "abs_start": 161.288,
    "abs_end": 162.132,
    "text": "끈끈히 추가."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_51",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 162.807,
    "end": 165.085,
    "abs_start": 162.807,
    "abs_end": 165.085,
    "text": "수학전 안전 사용 기준 확인 이렇게요."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_52",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 165.895,
    "end": 168.68,
    "abs_start": 165.895,
    "abs_end": 168.68,
    "text": "예, 알겠습니다. 고맙습니다."
   },
   {
    "file_index": 0,
    "audio_id": 1,
    "seg_id": "seg_53",
    "speaker": "A",
    "speaker_key": "f0:A",
    "start": 170.266,
    "end": 171.903,
    "abs_start": 170.266,
    "abs_end": 171.903,
    "text": "네, 더이 조심하세요, 사장님."
   },
   {
